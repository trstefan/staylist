generator client {
  provider    = "prisma-client-js"
  engineType  = "client"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id          String   @id @default(uuid())
  title       String
  artist      String
  url         String?
  description String?
  genre       String[]
  year        Int?
  album       String?
  cover       String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
